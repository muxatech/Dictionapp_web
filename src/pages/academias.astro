---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import AcademyBenefits from '../components/AcademyBenefits.astro';
import TryAction from '../components/TryAction.astro';
---

<Layout title="Dictionapp - Soluciones para academias">
  <Nav current="academias" />
  <section class="pt-32 pb-12" style="background: linear-gradient(135deg, #155263, #0C2F39);">
    <div class="container mx-auto px-6 text-center">
      <h1 class="text-5xl font-bold text-white mb-6">
        Dictionapp para Academias
      </h1>
      <p class="text-xl text-gray-200 max-w-3xl mx-auto">
        Lleva el aprendizaje de vocabulario de tus alumnos al siguiente nivel con herramientas diseñadas para instituciones educativas.
      </p>
    </div>
  </section>

  <AcademyBenefits />

  <section class="py-20" style="background: linear-gradient(135deg, #0C2F39, #155263);">
    <div class="container mx-auto px-6 max-w-4xl text-center">
      <h2 class="text-4xl font-bold text-white mb-6">
        ¿Eres profesor particular?
      </h2>
      <p class="text-xl text-gray-200 mb-8">
        También tenemos planes especiales para profesores independientes. Únete a nuestra plataforma y mejora los resultados de tus alumnos.
      </p>
      <a
        href="/contacto"
        class="inline-block px-8 py-4 rounded-full font-bold text-lg transition hover:scale-105"
        style="background: #FFC93C; color: #0C2F39;"
      >
        Quiero ser partner
      </a>
    </div>
  </section>

  <TryAction />
</Layout>
