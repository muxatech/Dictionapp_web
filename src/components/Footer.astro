---
---
<footer class="text-white py-16" style="background-color: #0C2F39;">
  <div class="container mx-auto px-6">
    <div class="grid md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-3">
          <img src="/favicon.png" class="h-10 w-10 object-contain" />
          <span class="text-xl font-bold">Dictionapp</span>
        </a>
        <p class="text-gray-300 text-sm">
          Tu vocabulario, a otro nivel. Aprende de forma inteligente con tu propio diccionario personal.
        </p>
        <p class="text-xs text-gray-400">
          Powered by <span class="font-semibold">Studio Muxa Tech, S.L.</span>
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-lg font-bold mb-4" style="color: #FFC93C;">
          Navegación
        </h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-300 hover:text-white transition">Inicio</a></li>
          <li><a href="/enfoque-educativo" class="text-gray-300 hover:text-white transition">Enfoque educativo</a></li>
          <li><a href="/academias" class="text-gray-300 hover:text-white transition">Academias</a></li>
          <li><a href="/contacto" class="text-gray-300 hover:text-white transition">Contacto</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-lg font-bold mb-4" style="color: #FFC93C;">
          Legal
        </h3>
        <ul class="space-y-2">
          <li><a href="/privacy-policy" class="text-gray-300 hover:text-white transition">Política de privacidad</a></li>
          <li><a href="/terms" class="text-gray-300 hover:text-white transition">Términos de servicio</a></li>
        </ul>
        <div class="mt-6">
          <h4 class="font-bold mb-2 text-sm" style="color: #FFD76F;">
            Contacto
          </h4>
          <a href="mailto:info@muxatech.com" class="text-gray-300 hover:text-white transition text-sm">
            info@muxatech.com
          </a>
        </div>
      </div>

      <!-- Social Media -->
      <div>
        <h3 class="text-lg font-bold mb-4" style="color: #FFC93C;">
          Síguenos
        </h3>
        <div class="flex gap-4">
          <a href="https://instagram.com/dictionapp/" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full flex items-center justify-center hover:opacity-80 transition" style="background-color: #1E758D;">
            <span class="text-sm font-bold">Ig</span>
          </a>
        </div>
        <div class="mt-6">
          <a
            href="/download"
            class="inline-block px-6 py-3 rounded-full font-bold text-sm transition hover:scale-105"
            style="background: #FFC93C; color: #0C2F39;"
          >
            Descargar la app
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-700 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-gray-400">
        © {new Date().getFullYear()} Dictionapp. Todos los derechos reservados.
      </p>
      <div class="flex gap-6">
        <a href="/privacy-policy" class="text-sm text-gray-400 hover:text-white transition">Privacidad</a>
        <a href="/terms" class="text-sm text-gray-400 hover:text-white transition">Términos</a>
        <a href="/contacto" class="text-sm text-gray-400 hover:text-white transition">Contacto</a>
      </div>
    </div>
  </div>
</footer>
